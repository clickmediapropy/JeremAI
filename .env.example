# JeremAI local / mock config. No secrets required for the dry-run demo.
# Copy to .env only if you add keys later. Never commit .env.

# Where SQLite, generated stubs, and assemble exports live (default: <repo>/.data)
JEREMAI_DATA_DIR=

# Optional: override ffmpeg binary
# FFMPEG_PATH=/usr/bin/ffmpeg

# Live spend is NEVER enabled by default. Both video backends are stubs.
# Even with these set, JeremAI will not call MiniMax or rent RunPod GPUs
# unless you later replace the adapters — and generate still requires --confirm.
JEREMAI_ALLOW_SPEND=0

# MiniMax H3 API (comparison ceiling only — adapter is a dry-run stub)
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io

# RunPod self-host H3 (hypothesis ~$0.17 / 5s — adapter is a dry-run stub)
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# Optional LLM for script polish (not used by default; local templates ship)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
