{
  "name": "jeremai",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Agent-native CLI for AI Nutra ad creative production — brief, B-roll reuse, claims lint, confirm-before-spend, assemble, cost ledger.",
  "type": "module",
  "bin": {
    "jeremai": "./bin/jeremai.js"
  },
  "scripts": {
    "jeremai": "node --no-warnings --import tsx src/cli.ts",
    "demo": "node --no-warnings --import tsx src/cli.ts demo",
    "desk": "node --no-warnings --import tsx src/desk/server.ts",
    "test": "node --no-warnings --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "js-yaml": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
